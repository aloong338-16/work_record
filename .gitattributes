* text=auto

# 明确指定文本文件用 LF
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Windows 批处理用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不要转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary